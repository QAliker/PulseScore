# Database
DATABASE_URL=postgresql://pulsescore:pulsescore@localhost:5432/pulsescore

# Redis
REDIS_URL=redis://localhost:6379

# External APIs — API-Football v3 (api-sports.io direct, header x-apisports-key)
API_FOOTBALL_KEY=your_api_key_here
APIFOOTBALL_TIMEZONE=Europe/Paris
# Football-Data.org (livescores)
FOOTBALL_DATA_ORG_KEY=your_fdo_key_here
THE_GUARDIAN_KEY=your_guardian_key_here
# App
NODE_ENV=development
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
